{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/super-admin",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/risk-heatmap",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|assets/|images/|download(?:\\.html)?$|sitemap\\.xml$|robots\\.txt$|favicon\\.ico$|favicon-[^/]+\\.png$|apple-touch-icon\\.png$).*)",
      "destination": "/index.html"
    }
  ]
}

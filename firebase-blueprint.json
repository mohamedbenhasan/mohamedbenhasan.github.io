{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": ["string", "null"] },
        "displayNameLowercase": { "type": ["string", "null"] },
        "photoURL": { "type": ["string", "null"] },
        "role": { "type": "string", "enum": ["ADMIN", "OPERATOR", "USER"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastActiveAt": { "type": "string", "format": "date-time" },
        "online": { "type": "boolean" }
      },
      "required": ["uid", "email", "role", "createdAt"]
    },
    "PublicProfile": {
      "title": "PublicProfile",
      "description": "Publicly readable profile information for a user.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": ["string", "null"] },
        "displayNameLowercase": { "type": ["string", "null"] },
        "photoURL": { "type": ["string", "null"] },
        "online": { "type": "boolean" },
        "lastActiveAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "online", "lastActiveAt"]
    },
    "RiskData": {
      "title": "RiskData",
      "description": "Historical risk scores and analytics",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "score": { "type": "number" },
        "level": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "location": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          },
          "required": ["lat", "lng"]
        },
        "modelUsed": { "type": "string" }
      },
      "required": ["userId", "score", "level", "timestamp", "location", "modelUsed"]
    },
    "TrackingData": {
      "title": "TrackingData",
      "description": "Historical locations and tracking data",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "location": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          },
          "required": ["lat", "lng"]
        },
        "velocity": {
          "type": "object",
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" }
          },
          "required": ["x", "y"]
        },
        "heading": { "type": "number" }
      },
      "required": ["userId", "timestamp", "location", "velocity", "heading"]
    },
    "LiveLocation": {
      "title": "LiveLocation",
      "description": "Real-time location of users for proximity detection",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "geohash": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "type": { "type": "string" }
      },
      "required": ["userId", "lat", "lng", "geohash", "timestamp", "type"]
    },
    "AlertEvent": {
      "title": "AlertEvent",
      "description": "Real-time collision alerts",
      "type": "object",
      "properties": {
        "mainUserId": { "type": "string" },
        "otherUserId": { "type": "string" },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "geohash": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "riskLevel": { "type": "string" }
      },
      "required": ["mainUserId", "lat", "lng", "geohash", "timestamp", "riskLevel"]
    },
    "DENMEvent": {
      "title": "DENMEvent",
      "description": "Decentralized Environmental Notification Message for V2X communication",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "eventType": { "type": "string", "enum": ["COLLISION_RISK", "DANGEROUS_ZONE", "UNAUTHORIZED_AREA"] },
        "location": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          },
          "required": ["lat", "lng"]
        },
        "timestamp": { "type": "number" },
        "riskLevel": { "type": "string" },
        "involvedUserIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "senderId": { "type": "string" },
        "expiresAt": { "type": "number" },
        "geohash": { "type": "string" }
      },
      "required": ["id", "eventType", "location", "timestamp", "riskLevel", "involvedUserIds", "senderId", "expiresAt", "geohash"]
    },
    "Feedback": {
      "title": "Feedback",
      "description": "User feedback on AI recommendations or simulation behavior",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "type": { "type": "string", "enum": ["RECOMMENDATION", "SIMULATION"] },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "recommendationText": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "context": { "type": "object" }
      },
      "required": ["uid", "type", "timestamp"]
    },
    "InfrastructureAlert": {
      "title": "InfrastructureAlert",
      "description": "Alerts triggered by entering dangerous or restricted infrastructure zones",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "location": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          },
          "required": ["lat", "lng"]
        },
        "vruType": { "type": "string" },
        "infraType": { "type": "string" },
        "safetyLevel": { "type": "string" },
        "message": { "type": "string" }
      },
      "required": ["userId", "timestamp", "location", "vruType", "infraType", "safetyLevel", "message"]
    },
    "SessionRecord": {
      "title": "SessionRecord",
      "description": "Historical simulation sessions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "duration": { "type": "number" },
        "user": { "type": "object" },
        "context": { "type": "object" },
        "metrics": {
          "type": "object",
          "properties": {
            "avgError": { "type": "number" },
            "collisionWarnings": { "type": "number" },
            "quantumFusionActive": { "type": "boolean" }
          },
          "required": ["avgError", "collisionWarnings", "quantumFusionActive"]
        },
        "summary": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["id", "timestamp", "duration", "user", "context", "metrics", "userId"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Direct 1-1 conversation between two users",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["direct"] },
        "members": {
          "type": "array",
          "items": { "type": "string" }
        },
        "membersKey": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "lastMessage": {
          "type": "object",
          "properties": {
            "text": { "type": "string" },
            "senderId": { "type": "string" },
            "createdAt": { "type": "string", "format": "date-time" }
          },
          "required": ["text", "senderId", "createdAt"]
        }
      },
      "required": ["type", "members", "membersKey", "createdAt", "updatedAt"]
    },
    "Message": {
      "title": "Message",
      "description": "A message within a conversation",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "type": { "type": "string", "enum": ["text"] },
        "status": { "type": "string", "enum": ["sent", "delivered", "read"] }
      },
      "required": ["senderId", "text", "createdAt", "type"]
    },
    "Incident": {
      "title": "Incident",
      "description": "User reported incident on the map",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["ROADWORKS", "ROAD_CLOSED", "SIDEWALK_CLOSED", "DANGER", "ACCIDENT", "OBSTACLE", "OTHER"] },
        "severity": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },
        "description": { "type": "string" },
        "location": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          },
          "required": ["lat", "lng"]
        },
        "geohash": { "type": "string" },
        "createdAt": { "type": "number" },
        "createdByUserId": { "type": "string" },
        "expiresAt": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "resolved", "removed"] },
        "photoUrl": { "type": "string" },
        "upvotes": { "type": "number" },
        "reportsCount": { "type": "number" }
      },
      "required": ["type", "severity", "location", "geohash", "createdAt", "createdByUserId", "expiresAt", "status", "upvotes", "reportsCount"]
    },
    "ZoneReview": {
      "title": "ZoneReview",
      "description": "A user-submitted review for a specific geographic zone (geohash).",
      "type": "object",
      "properties": {
        "geohash": { "type": "string" },
        "userId": { "type": "string" },
        "isAnonymous": { "type": "boolean" },
        "rating": { "type": "number", "minimum": 1, "maximum": 5 },
        "comment": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "timeContext": { "type": "string", "enum": ["day", "night", "unknown"] },
        "createdAt": { "type": "number" }
      },
      "required": ["geohash", "userId", "isAnonymous", "rating", "createdAt"]
    },
    "ZoneStats": {
      "title": "ZoneStats",
      "description": "Aggregated statistics for a specific zone.",
      "type": "object",
      "properties": {
        "geohash": { "type": "string" },
        "averageRating": { "type": "number" },
        "reviewCount": { "type": "number" }
      },
      "required": ["geohash", "averageRating", "reviewCount"]
    },
    "CommunityRoute": {
      "title": "CommunityRoute",
      "description": "User recommended safe route",
      "type": "object",
      "properties": {
        "startAddress": { "type": "string" },
        "endAddress": { "type": "string" },
        "routePoints": {
          "type": "array",
          "items": { "type": "object", "properties": { "lat": {"type":"number"}, "lng": {"type":"number"} } }
        },
        "geohashes": { "type": "array", "items": {"type": "string"} },
        "userId": { "type": "string" },
        "timeContext": { "type": "string", "enum": ["day", "night", "always"] },
        "mode": { "type": "string", "enum": ["walk", "transport", "bike"] },
        "reasons": { "type": "array", "items": { "type": "string" } },
        "upvotes": { "type": "number" },
        "downvotes": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["startAddress", "endAddress", "routePoints", "geohashes", "userId", "timeContext", "mode", "upvotes", "downvotes", "createdAt"]
    },
    "RouteVote": {
      "title": "RouteVote",
      "description": "User votes on community routes",
      "type": "object",
      "properties": {
        "routeId": { "type": "string" },
        "userId": { "type": "string" },
        "vote": { "type": "number", "enum": [1, -1] },
        "timestamp": { "type": "number" }
      },
      "required": ["routeId", "userId", "vote", "timestamp"]
    },
    "LiveTrackingSession": {
      "title": "LiveTrackingSession",
      "description": "A secure, revocable token-based session for a third party to track a VRU",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "token": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "number" },
        "expiresAt": { "type": "number" },
        "lastLocation": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" },
            "timestamp": { "type": "number" }
          },
          "required": ["lat", "lng", "timestamp"]
        }
      },
      "required": ["userId", "token", "active", "createdAt", "expiresAt"]
    },
    "ParentalLink": {
      "title": "ParentalLink",
      "description": "Persistent tracking link from parent to child",
      "type": "object",
      "properties": {
        "parentId": { "type": "string" },
        "childId": { "type": ["string", "null"] },
        "childName": { "type": ["string", "null"] },
        "inviteCode": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "active", "revoked", "paused"] },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["parentId", "inviteCode", "status", "createdAt", "updatedAt"]
    },
    "Subscription": {
      "title": "Subscription",
      "description": "Server-verified or Redeem-verified user subscription state and billing lifecycle",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": ["string", "null"] },
        "plan": { "type": "string", "enum": ["FREE", "PREMIUM", "FAMILY", "BUSINESS"] },
        "basePlan": { "type": "string", "enum": ["FREE", "PREMIUM", "FAMILY", "BUSINESS"] },
        "status": { "type": "string", "enum": ["active", "expired", "canceled", "pending", "suspended"] },
        "billingCycle": { "type": "string", "enum": ["monthly", "annual", "custom"] },
        "startDate": { "type": "string", "format": "date-time" },
        "endDate": { "type": ["string", "null"], "format": "date-time" },
        "isLifetime": { "type": "boolean" },
        "cancelAtPeriodEnd": { "type": "boolean" },
        "isEarlyTester": { "type": "boolean" },
        "earlyTesterStartDate": { "type": ["string", "null"], "format": "date-time" },
        "earlyTesterEndDate": { "type": ["string", "null"], "format": "date-time" },
        "activationSource": { "type": "string", "enum": ["free", "stripe", "konnect", "early_tester", "pioneer", "accessibility", "admin", "redeem"] },
        "paymentProvider": { "type": ["string", "null"], "enum": ["stripe", "konnect", "early_tester", "admin", "redeem", "accessibility", "pioneer", null] },
        "paymentVerified": { "type": "boolean" },
        "lastPaymentRef": { "type": ["string", "null"] },
        "redeemCodeHash": { "type": ["string", "null"], "maxLength": 64, "pattern": "^[a-f0-9]{64}$" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "plan", "status", "paymentVerified", "updatedAt"]
    },
    "EarlyTester": {
      "title": "EarlyTester",
      "description": "Admin-managed or legacy early tester 2-year free Premium record",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "active": { "type": "boolean" },
        "startDate": { "type": "string", "format": "date-time" },
        "endDate": { "type": "string", "format": "date-time" },
        "note": { "type": "string" }
      },
      "required": ["uid", "active", "startDate", "endDate"]
    },
    "FamilyProfile": {
      "title": "FamilyProfile",
      "description": "Centralized family member profile managed by a Family or Business subscriber",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerUid": { "type": "string" },
        "memberUid": { "type": ["string", "null"] },
        "name": { "type": "string", "maxLength": 100 },
        "relation": { "type": "string", "enum": ["parent", "child", "spouse", "senior", "other"] },
        "vruType": { "type": "string" },
        "shareLocation": { "type": "boolean" },
        "sosAlertsEnabled": { "type": "boolean" },
        "geofenceAlertEnabled": { "type": "boolean" },
        "speedAlertThresholdKmh": { "type": "number" },
        "emergencyContactPhone": { "type": "string", "maxLength": 40 },
        "status": { "type": "string", "enum": ["active", "paused", "pending"] },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "ownerUid", "name", "relation", "status", "createdAt", "updatedAt"]
    },
    "BusinessQuote": {
      "title": "BusinessQuote",
      "description": "Enterprise quote request for VruGuard Business plan",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": ["string", "null"] },
        "companyName": { "type": "string", "maxLength": 150 },
        "contactName": { "type": "string", "maxLength": 120 },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string", "maxLength": 40 },
        "teamSize": { "type": "string", "maxLength": 40 },
        "vehicleCount": { "type": "string", "maxLength": 40 },
        "needsApi": { "type": "boolean" },
        "message": { "type": "string", "maxLength": 2000 },
        "status": { "type": "string", "enum": ["new", "reviewed", "approved", "closed"] },
        "internalNote": { "type": ["string", "null"], "maxLength": 2000 },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": ["number", "null"] }
      },
      "required": ["id", "companyName", "contactName", "email", "status", "createdAt"]
    },
    "TrustedConnection": {
      "title": "TrustedConnection",
      "description": "Bidirectional trusted emergency connection between two VruGuard users (Premium+)",
      "type": "object",
      "properties": {
        "userA": { "type": "string" },
        "userB": { "type": "string" },
        "initiatorId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userA", "userB", "initiatorId", "status", "createdAt"]
    },
    "SosAlert": {
      "title": "SosAlert",
      "description": "Emergency SOS alert broadcast (Premium+)",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "vruType": { "type": "string" },
        "geohash6": { "type": "string" },
        "trustedViewerIds": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["active", "resolved", "cancelled"] },
        "reportsCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "number" }
      },
      "required": ["userId", "vruType", "geohash6", "status", "reportsCount", "createdAt", "expiresAt"]
    },
    "PersonalContact": {
      "title": "PersonalContact",
      "description": "Personal emergency contact under user subcollection (Premium+)",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 40 },
        "email": { "type": "string", "maxLength": 200 },
        "whatsapp": { "type": "string", "maxLength": 40 },
        "relation": { "type": "string", "maxLength": 60 },
        "priority": { "type": "number" },
        "preferredChannel": { "type": "string", "enum": ["SMS", "WHATSAPP", "EMAIL", "CALL"] }
      },
      "required": ["name", "phone", "priority"]
    },
    "SosSettings": {
      "title": "SosSettings",
      "description": "User SOS trigger & channel configuration (Premium+)",
      "type": "object",
      "properties": {
        "categories": { "type": "array" },
        "liveLocationEnabled": { "type": "boolean" },
        "liveLocationDurationMinutes": { "type": "number" },
        "antiFalseClick": { "type": "boolean" },
        "antiFalseClickType": { "type": "string", "enum": ["LONG_PRESS", "SLIDER"] },
        "securityCheckInEnabled": { "type": "boolean" },
        "securityCheckInMinutes": { "type": "number" }
      },
      "required": ["categories", "liveLocationEnabled"]
    },
    "SosLog": {
      "title": "SosLog",
      "description": "Audit log of triggered SOS events (Premium+)",
      "type": "object",
      "properties": {
        "timestamp": { "type": "string", "format": "date-time" },
        "categoryId": { "type": "string" },
        "recipientIds": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["sent", "call_initiated", "failed", "canceled"] },
        "channelsUsed": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["timestamp", "categoryId", "recipientIds", "status", "channelsUsed"]
    },
    "UserConsent": {
      "title": "UserConsent",
      "description": "Timestamped user GDPR and terms consent record synced across Web and Android",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": ["string", "null"] },
        "status": { "type": "string", "enum": ["pending", "accepted", "refused", "withdrawn"] },
        "consentVersion": { "type": "string" },
        "termsVersion": { "type": "string" },
        "privacyVersion": { "type": "string" },
        "acceptedAt": { "type": ["number", "null"] },
        "refusedAt": { "type": ["number", "null"] },
        "withdrawnAt": { "type": ["number", "null"] },
        "platform": { "type": "string", "enum": ["web", "android"] },
        "optionalConsents": { "type": "object" },
        "updatedAt": { "type": "number" }
      },
      "required": [
        "userId",
        "status",
        "consentVersion",
        "termsVersion",
        "privacyVersion",
        "platform",
        "optionalConsents",
        "updatedAt"
      ]
    },
    "AccessibilityRequest": {
      "title": "AccessibilityRequest",
      "description": "User-submitted disability / reduced mobility verification request for lifetime Premium access",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "email": { "type": ["string", "null"] },
        "displayName": { "type": ["string", "null"] },
        "fullName": { "type": "string", "maxLength": 120 },
        "disabilityCategory": { "type": "string", "maxLength": 120 },
        "description": { "type": "string", "maxLength": 2000 },
        "documentName": { "type": "string", "maxLength": 255 },
        "documentMimeType": { "type": "string", "maxLength": 120 },
        "documentSize": { "type": "number" },
        "hasDocumentFile": { "type": "boolean" },
        "documentDataUrl": { "type": ["string", "null"], "maxLength": 750000 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "more_info_required"] },
        "adminComment": { "type": ["string", "null"], "maxLength": 1000 },
        "reviewedBy": { "type": ["string", "null"] },
        "reviewedAt": { "type": ["number", "null"] },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "history": { "type": "array" }
      },
      "required": [
        "id",
        "uid",
        "fullName",
        "disabilityCategory",
        "description",
        "documentName",
        "documentMimeType",
        "documentSize",
        "hasDocumentFile",
        "status",
        "createdAt",
        "updatedAt",
        "history"
      ]
    },
    "RedeemCode": {
